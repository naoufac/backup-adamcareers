# ADAMJOBS environment. Copy to .env and fill. Never commit .env.

# --- Runtime ---
NODE_ENV=development
WEB_PORT=8780
API_PORT=8781
APP_BASE_URL=http://localhost:8780
API_BASE_URL=http://localhost:8781
In production set to your public API subdomain:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8781

# --- Database (Postgres) ---
POSTGRES_USER=adam
POSTGRES_PASSWORD=change_me
POSTGRES_DB=adamjobs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-visible port for migrations / psql (bound to 127.0.0.1 only):
POSTGRES_HOST_PORT=5433
# Local dev (pnpm dev): host-mapped port:
DATABASE_URL=postgres://adam:change_me@localhost:5433/adamjobs
# In Docker, docker-compose.yml overrides this to postgres:5432.

# --- Cache / Queue (Redis) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
# Session signing secret (generate: openssl rand -hex 32)
AUTH_JWT_SECRET=replace_with_long_random_hex
AUTH_COOKIE_NAME=adam_session
# Composio OAuth (https://dashboard.composio.dev)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_REDIRECT_URL=http://localhost:8781/auth/composio/callback
# Toolkit slugs enabled for login (Composio names):
COMPOSIO_LOGIN_TOOLKITS=google,linkedin

# --- LLM: Z.AI primary (GLM-4.7) ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-4.7

# --- LLM fallback: OpenRouter (minimax) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://adamcareers.com
OPENROUTER_TITLE=AdamCareers

# --- Job search APIs (later milestones) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_BANK_GC_BASE=https://www.jobbank.gc.ca

# --- Web research ---
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Billing (Stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# EXPORT_PRICE_CENTS=100
# PAYMENT_CURRENCY=usd
